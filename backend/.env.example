# Voice (STT + TTS): Gnani Prisma and Timbre. Get a key at app.gnani.ai/voice
GNANI_API_KEY=
# Translation and the scam-shield LLM: Sarvam
SARVAM_API_KEY=
# Signs join tokens. In production (APP_ENV=production) the server refuses to start unless this is
# a random string of 32+ characters. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_ENV=development

# Optional overrides
# STT_PROVIDER=gnani              # gnani | sarvam
# TTS_PROVIDER=gnani              # gnani | sarvam
# TRANSLATE_PROVIDER=sarvam       # sarvam | indictrans2 (stub)
# TRANSLATE_MODEL=sarvam-translate:v1
# SCAM_ENABLED=true
# SCAM_LLM_ENABLED=true           # false = rules only (no Sarvam chat calls)
# MAX_ROOMS=200
# TRANSCRIPT_RETENTION_DAYS=7
# DATABASE_URL=sqlite+aiosqlite:///./calls.db
